<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>4TEL – Quadrant Visualizer</title>
<style>
body { background:#000; color:#0f0; font-family:monospace; padding:40px; }
pre { background:#111; padding:20px; border-left:3px solid #6cf; }
</style>
</head>

<body>

<h1>4TEL – Quadrant Visualizer</h1>
<pre id="out">Lade 4TEL…</pre>

<script type="module">
import { TEL3 } from "./3TEL.js";

const QUAD4 = {
  Q1: TEL3.tri("PER"),
  Q2: TEL3.tri("PER"),
  Q3: TEL3.tri("PER"),
  Q4: TEL3.tri("PER")
};

document.getElementById("out").innerText =
  Object.entries(QUAD4)
    .map(([q, seg]) => `${q}: ${seg.join(" → ")}`)
    .join("\n\n");
</script>

</body>
</html>
