<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>4TEL – PX‑Gate Animation</title>
<style>
body { background:#000; color:#0f0; font-family:monospace; }
#anim { font-size:32px; text-align:center; margin-top:100px; }
</style>
</head>

<body>

<div id="anim">PX‑Gate lädt…</div>

<script type="module">
import { TEL4_PIPE } from "./4TEL.pipe.js";

const out = TEL4_PIPE.run("PER");

let frames = [
  out.vectors.v1,
  out.vectors.v2,
  out.vectors.v3,
  "◎",
  "▣"
];

let i = 0;
setInterval(() => {
  document.getElementById("anim").innerText = frames[i];
  i = (i + 1) % frames.length;
}, 600);
</script>

</body>
</html>
